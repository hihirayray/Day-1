{"kind":"textbox","id":"sh/9ovmx07i","slide":13,"text":"Close the AI tabs. Now find what both missed.","textPreview":"Close the AI tabs. Now find what both missed.","textChars":45,"textLines":1,"bbox":[48,72,1120,74]}
