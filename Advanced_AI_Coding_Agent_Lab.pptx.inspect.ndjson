{"kind":"textbox","id":"sh/ut8325wj","slide":2,"text":"Fast code is not the goal.","textPreview":"Fast code is not the goal.","textChars":26,"textLines":1,"bbox":[48,150,1110,90]}
{"kind":"textbox","id":"sh/vuh4baxo","slide":2,"text":"Controlled, explainable, tested code is.","textPreview":"Controlled, explainable, tested code is.","textChars":40,"textLines":1,"bbox":[48,270,1090,150]}
{"kind":"textbox","id":"sh/87ql0ved","slide":2,"text":"You will be rewarded for finding subtle failure—not for shipping the flashiest feature.","textPreview":"You will be rewarded for finding subtle failure—not for shipping the flashiest feature.","textChars":87,"textLines":1,"bbox":[48,546,1040,72]}
